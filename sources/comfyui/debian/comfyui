#!/bin/sh
# comfyui - run the ComfyUI staged in /usr/lib/comfyui from a per-user
# virtualenv, creating that virtualenv on first run (or after a package
# upgrade, tracked by a version stamp). Extra arguments go to main.py,
# e.g. "comfyui --listen 0.0.0.0 --port 8188 --auto-launch".
#
# Environment:
#   COMFYUI_HOME         base dir (default $XDG_DATA_HOME/comfyui, i.e.
#                        ~/.local/share/comfyui); holds venv/, models/,
#                        custom_nodes/, input/, output/, user/, temp/
#   COMFYUI_TORCH_INDEX  pip index for torch (default: PyTorch CPU wheels)
#   COMFYUI_APP          the staged source tree (default /usr/lib/comfyui)
set -eu

APP=${COMFYUI_APP:-/usr/lib/comfyui}
BASE=${COMFYUI_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/comfyui}
VENV=$BASE/venv
TORCH_INDEX=${COMFYUI_TORCH_INDEX:-https://download.pytorch.org/whl/cpu}
VERSION=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$APP/comfyui_version.py")

if [ "$(id -u)" -eq 0 ] && [ -z "${COMFYUI_ALLOW_ROOT:-}" ]; then
    echo "comfyui: refusing to run as root (it would set up /root/.local/share/comfyui)." >&2
    echo "Run it as your normal user, or set COMFYUI_ALLOW_ROOT=1." >&2
    exit 1
fi

mkdir -p "$BASE"
if [ "$(cat "$VENV/.comfyui-version" 2>/dev/null)" != "$VERSION" ]; then
    echo "comfyui: setting up the Python environment in $VENV" >&2
    echo "comfyui: (first run or upgrade to $VERSION; downloads about 1 GB of wheels, 2.5 GB on disk)" >&2
    [ -x "$VENV/bin/python" ] || python3 -m venv "$VENV"
    "$VENV/bin/pip" install torch torchvision torchaudio --index-url "$TORCH_INDEX"
    "$VENV/bin/pip" install -r "$APP/requirements.txt"
    echo "$VERSION" > "$VENV/.comfyui-version"
fi

# Seed the standard folder skeleton (models/<type>/, bundled custom_nodes,
# the example input) the way a git checkout has it. Never overwrites.
for d in models custom_nodes input; do
    [ -e "$BASE/$d" ] || cp -R "$APP/$d" "$BASE/$d"
done

# ComfyUI assumes CUDA unless told otherwise, and the CPU torch build has
# none, so force --cpu whenever we installed the CPU wheels.
[ "$TORCH_INDEX" = https://download.pytorch.org/whl/cpu ] && set -- --cpu "$@"

cd "$BASE"
exec "$VENV/bin/python" "$APP/main.py" --base-directory "$BASE" "$@"
